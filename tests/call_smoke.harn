import {
  artifact_export_request,
  artifact_import_request,
  call,
  init,
  request_descriptor,
  shutdown,
} from "../src/lib"
import { expect, expect_eq } from "../testdata/assertions"

pipeline test_call_smoke(harness: Harness) {
  shutdown(harness)
  const normalized = init(harness, "invalid-context")
  expect_eq(normalized.ctx, {}, "non-dict init context is normalized")
  const initialized = init(harness, {access_token: "secret_access"})
  expect_eq(initialized.ctx.access_token, "secret_access", "dict init context is retained")
  harness.testing.http_mock_clear()
  const drive = "https://www.googleapis.com/drive/v3"
  const docs = "https://docs.googleapis.com/v1"
  const gmail = "https://gmail.googleapis.com/gmail/v1"
  harness.testing.http_mock(
    "*",
    "https://www.googleapis.com/*",
    {
      responses: [
        {status: 200, body: "{\"id\":\"file_123\",\"name\":\"Report\"}", headers: {}},
        {status: 200, body: "{\"files\":[{\"id\":\"file_123\"}]}", headers: {}},
        {status: 200, body: "{\"startPageToken\":\"start_123\"}", headers: {}},
        {
          status: 200,
          body:
            "{\"changes\":[{\"fileId\":\"file_123\",\"file\":{\"id\":\"file_123\",\"name\":\"Report\"}}],\"newStartPageToken\":\"next_123\"}",
          headers: {},
        },
      ],
    },
  )
  harness.testing.http_mock(
    "*",
    "https://docs.googleapis.com/*",
    {
      responses: [
        {status: 200, body: "{\"documentId\":\"doc_123\",\"title\":\"Report\"}", headers: {}},
      ],
    },
  )
  harness.testing.http_mock(
    "*",
    "https://gmail.googleapis.com/*",
    {
      responses: [
        {
          status: 200,
          body: "{\"messages\":[{\"id\":\"msg_123\",\"threadId\":\"thread_1\"}]}",
          headers: {},
        },
        {
          status: 200,
          body:
            "{\"id\":\"msg_123\",\"threadId\":\"thread_1\",\"payload\":{\"headers\":[{\"name\":\"Subject\",\"value\":\"Your receipt\"}],\"parts\":[{\"filename\":\"receipt.pdf\",\"body\":{\"attachmentId\":\"att_123\",\"size\":12}}]}}",
          headers: {},
        },
        {status: 200, body: "{\"data\":\"cmVjZWlwdA\",\"size\":7}", headers: {}},
      ],
    },
  )
  const file = call(harness, "drive.files.get", {file_id: "file_123", fields: "id,name"})
  expect_eq(file.id, "file_123", "files.get response")
  call(harness, "drive.files.list", {q: "name='Report'", page_size: 10})
  const create_rejected = call(
    harness,
    "drive.files.create",
    {name: "Report", mimeType: "application/vnd.google-apps.document"},
  )
  expect(is_err(create_rejected), "mutating Drive create requires an external action")
  expect_eq(unwrap_err(create_rejected).code, "external_action_required", "governance code")
  const legacy_approved = call(
    harness,
    "drive.files.create",
    {
      name: "Report",
      mimeType: "application/vnd.google-apps.document",
      upload_type: "multipart",
      _approved: true,
    },
  )
  expect(is_err(legacy_approved), "legacy approval flag cannot bypass external-action policy")
  expect_eq(
    unwrap_err(legacy_approved).code,
    "external_action_required",
    "legacy approval flag is ignored",
  )
  for governed in [
    {method: "drive.files.update", args: {file_id: "file_123"}},
    {
      method: "drive.changes.watch",
      args: {
        page_token: "start_123",
        id: "chan_123",
        type: "web_hook",
        address: "https://example.test/hook",
      },
    },
    {method: "docs.documents.create", args: {title: "Report"}},
    {
      method: "docs.documents.batchUpdate",
      args: {
        document_id: "doc_123",
        requests: [{insertText: {location: {index: 1}, text: "Hello"}}],
      },
    },
  ] {
    const denied = call(harness, governed.method, governed.args + {_approved: true})
    expect(is_err(denied), governed.method + " must not use the generic call path")
    expect_eq(
      unwrap_err(denied).code,
      "external_action_required",
      governed.method + " ignores legacy auto-approval",
    )
  }
  call(harness, "drive.changes.getStartPageToken", {})
  call(harness, "drive.changes.list", {page_token: "start_123", page_size: 5})
  call(harness, "docs.documents.get", {document_id: "doc_123"})
  const gmail_messages = call(
    harness,
    "gmail.messages.list",
    {q: "receipt newer_than:30d", max_results: 5},
  )
  expect_eq(gmail_messages.messages[0].id, "msg_123", "gmail messages.list response")
  const gmail_message = call(harness, "gmail.messages.get", {message_id: "msg_123", format: "full"})
  expect_eq(gmail_message.id, "msg_123", "gmail messages.get response")
  const attachment = call(
    harness,
    "gmail.messages.attachments.get",
    {message_id: "msg_123", attachment_id: "att_123"},
  )
  expect_eq(attachment.data, "cmVjZWlwdA", "gmail attachment response")
  const calls = harness.testing.http_mock_calls({include_sensitive: true})
  expect_eq(len(calls), 8, "only read operations reached Google")
  expect_eq(calls[0].method, "GET", "files.get uses GET")
  expect_eq(calls[0].url, drive + "/files/file_123?fields=id%2Cname", "files.get URL")
  expect_eq(calls[0].headers.authorization, "Bearer secret_access", "authorization header sent")
  expect_eq(calls[3].url, drive + "/changes?pageSize=5&pageToken=start_123", "changes list URL")
  expect_eq(calls[4].url, docs + "/documents/doc_123", "docs get URL")
  expect_eq(
    calls[5].url,
    gmail + "/users/me/messages?maxResults=5&q=receipt%20newer_than%3A30d",
    "gmail list URL",
  )
  expect_eq(calls[5].headers.authorization, "Bearer secret_access", "gmail authorization header")
  expect_eq(calls[6].url, gmail + "/users/me/messages/msg_123?format=full", "gmail get URL")
  expect_eq(
    calls[7].url,
    gmail + "/users/me/messages/msg_123/attachments/att_123",
    "gmail attachment URL",
  )
  const export = artifact_export_request(
    {file_id: "file_123", mime_type: "application/pdf", name: "report.pdf"},
  )
  expect_eq(export.kind, "artifact_export", "export descriptor kind")
  expect_eq(export.method, "GET", "export descriptor method")
  expect_eq(export.artifact.mime_type, "application/pdf", "export artifact mime")
  const import_request = artifact_import_request(
    {
      name: "report.docx",
      uri: "artifact://session/report.docx",
      mime_type: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      target_mime_type: "application/vnd.google-apps.document",
      parents: ["folder_123"],
    },
  )
  expect_eq(import_request.kind, "artifact_import", "import descriptor kind")
  expect_eq(
    import_request.metadata.mimeType,
    "application/vnd.google-apps.document",
    "import target mime",
  )
  expect_eq(import_request.media.uri, "artifact://session/report.docx", "import media uri")
  const descriptor = request_descriptor(
    "drive.files.export",
    {access_token: "secret_access", file_id: "file_123", mime_type: "application/pdf"},
  )
  expect(!is_err(descriptor), "export request descriptor builds")
  expect_eq(
    unwrap(descriptor).url,
    drive + "/files/file_123/export?mimeType=application%2Fpdf",
    "export request URL",
  )
  const bad_host = call(
    harness,
    "drive.files.get",
    {
      file_id: "file_123",
      access_token: "secret_access",
      drive_api_base_url: "https://evil.example/drive/v3",
    },
  )
  expect(is_err(bad_host), "disallowed api_base_url rejected")
  expect_eq(unwrap_err(bad_host).code, "disallowed_api_base_url", "disallowed host code")
  harness.testing.http_mock_clear()
  shutdown(harness)
}
